___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');
const logToConsole = require('logToConsole');

const SCRIPT_BASE_URL = 'https://scripts.seorce.com/api?projectId=';

const projectId = data.projectId ? makeString(data.projectId).trim() : '';

if (!projectId) {
  logToConsole('SEORCE: Project ID is missing. The SEORCE script was not loaded.');
  data.gtmOnFailure();
} else {
  // ref=gtm marks installs made through this template (the GTM equivalent of
  // the data-injected attribute in the Custom HTML snippet).
  const scriptUrl = SCRIPT_BASE_URL + encodeUriComponent(projectId) + '&ref=gtm';

  // The cache token makes sure the script is injected only once per page,
  // even if the tag fires several times (for example on SPA history changes).
  injectScript(scriptUrl, data.gtmOnSuccess, function () {
    logToConsole('SEORCE: Failed to load ' + scriptUrl);
    data.gtmOnFailure();
  }, 'seorce_' + projectId);
}


