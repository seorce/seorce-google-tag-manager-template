___TESTS___

scenarios:
- name: Injects the SEORCE script for the given Project ID
  code: |-
    let injectedUrl;
    let usedCacheToken;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injectedUrl = url;
      usedCacheToken = cacheToken;
      onSuccess();
    });

    runCode({projectId: '6ae196592b4146f493a796af'});

    assertThat(injectedUrl).isEqualTo('https://scripts.seorce.com/api?projectId=6ae196592b4146f493a796af&ref=gtm');
    assertThat(usedCacheToken).isEqualTo('seorce_6ae196592b4146f493a796af');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Trims whitespace around the Project ID
  code: |-
    let injectedUrl;
    mock('injectScript', (url, onSuccess) => {
      injectedUrl = url;
      onSuccess();
    });

    runCode({projectId: '  6ae196592b4146f493a796af  '});

    assertThat(injectedUrl).isEqualTo('https://scripts.seorce.com/api?projectId=6ae196592b4146f493a796af&ref=gtm');
    assertApi('gtmOnSuccess').wasCalled();
- name: Calls gtmOnFailure when the script fails to load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });

    runCode({projectId: '6ae196592b4146f493a796af'});

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Script URL is allowed by the inject_script permission
  code: |-
    const queryPermission = require('queryPermission');

    assertThat(queryPermission('inject_script', 'https://scripts.seorce.com/api?projectId=6ae196592b4146f493a796af&ref=gtm')).isTrue();
    assertThat(queryPermission('inject_script', 'https://evil.example.com/api?projectId=6ae196592b4146f493a796af')).isFalse();
- name: Does not inject anything when the Project ID is empty
  code: |-
    runCode({projectId: ''});

    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: ''


